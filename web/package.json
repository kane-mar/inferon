{
  "name": "inferon-web",
  "author": "Ixartz (https://github.com/ixartz)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@logtape/logtape": "^2.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/prompt-cli": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.2.9",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-refresh": "^0.5.3",
    "knip": "^6.17.1",
    "lefthook": "^2.1.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vitest-browser-react": "^2.2.0"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
