  "Hero": {
    "badge": "Works with the OpenAI API",
    "title": "Know what every AI request <important>really costs</important>.",
    "description": "Inferon sits between your app and the AI providers. It measures each request, protects your budget and moves traffic to cheaper models: and your current OpenAI client keeps working unchanged.",
    "primary_button": "Sign in with GitHub",
    "secondary_button": "View source"
  },
  "Features": {
    "section_subtitle": "Features",
    "section_title": "Everything you need to trust your AI spend",
    "feature1_title": "The real cost of each request",
    "feature1_description": "Every request stores its token counts and what the provider charged, in exact dollars and cents: never a rounded estimate.",
    "feature2_title": "Budget protection",
    "feature2_description": "Set a budget for each workspace. When it runs low, Inferon switches to a cheaper model instead of letting the bill run past the limit.",
    "feature3_title": "Output checker",
    "feature3_description": "Checks that the JSON a model sends back matches the shape you asked for, and fixes it. If it still fails, the request is retried on a stronger model.",
    "feature4_title": "Works with the OpenAI API",
    "feature4_description": "Point your client at /v1/chat/completions and keep your current SDK, keys and request formats.",
    "feature5_title": "One key per workspace",
    "feature5_description": "Create and revoke API keys for each workspace from the dashboard. Only a hash of each key is stored, never the key itself.",
    "feature6_title": "Sign in with GitHub",
    "feature6_description": "People sign in with GitHub and get a signed session cookie. Teammates join by invite and use their own API keys."
  },
