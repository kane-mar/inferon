# TLS ingress for the durable deployment (compose profile "prod").
# The site address comes from the INFERON_HOST env (set by deploy-durable.sh).
# Pin the production ACME directory explicitly: Caddy otherwise falls back to
# the Let's Encrypt *staging* CA after repeated challenge failures, which would
# serve an untrusted certificate.
{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS} {
	# The Rust data plane owns the API + auth surfaces.
	@api path /v1/* /auth/* /healthz
	handle @api {
		reverse_proxy proxy:8080
	}

	# Everything else is the Next.js human surfaces (ITEM-042e).
	handle {
		reverse_proxy web:3000
	}
}
