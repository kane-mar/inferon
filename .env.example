# Inferon proxy — copy this to .env and fill in secrets
PORT=8080
# Upstream chat-completions URL (default: https://api.deepseek.com/v1/chat/completions)
# UPSTREAM_URL=https://api.deepseek.com/v1/chat/completions
# Operator dashboard key (optional; enables the platform-wide /api/operator/* views)
# OPERATOR_API_KEY=sk-operator-secret
# Cost anomaly alerts webhook (ITEM-020; optional — alerts persist + list in the
# operator view even without it)
# ALERT_WEBHOOK_URL=https://hooks.example.com/inferon-alerts
# GitHub OAuth + sessions (ITEM-035; optional — without all three, /auth/login
# answers 503 and no human sessions are issued):
#   GITHUB_CLIENT_ID=      # OAuth app client id
#   GITHUB_CLIENT_SECRET=  # OAuth app client secret
#   SESSION_SECRET=        # long random secret signing session cookies
# Platform operators (ITEM-037): comma-separated GitHub logins whose sessions
# can open the operator console + operator APIs (env-login bootstrap):
#   OPERATOR_GITHUB_LOGINS=octocat,kanemar
# Self-serve signup (ITEM-036; optional): the shared upstream master key that
# auto-provisioned tenants start on (a tenant with its own provider key replaces
# it later):
#   UPSTREAM_MASTER_KEY=
# Mock GitHub OAuth endpoints for the smoke run only (defaults: github.com):
#   GITHUB_AUTHORIZE_URL=/GITHUB_TOKEN_URL=/GITHUB_API_URL=
# DeepSeek is the current default AI (see wiki: project direction)
# Tenant auth keys live on the api_keys table (hashes only — one tenant may hold
# several revocable keys). Seed a tenant with scripts/seed-tenant.sh to
# authenticate requests.
